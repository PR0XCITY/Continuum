# Copy this file to .env and fill in real values. Never commit .env.

# Required by src/continuum/connector/auth.py. Every request to the
# connector API, including requests from localhost, must present this
# token as a bearer token. Generate a long random value, for example
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONTINUUM_API_TOKEN=change-me-to-a-long-random-token

# Optional overrides of config/default.yaml. Leave commented out to use
# the defaults.
# CONTINUUM_DETECTION__ANOMALY_THRESHOLD=0.65
# CONTINUUM_RESPONSE__MODE=enforce
# CONTINUUM_CONNECTOR__PORT=8731
# CONTINUUM_RAG__OLLAMA_HOST=http://127.0.0.1:11434
# CONTINUUM_RAG__OLLAMA_MODEL=llama3.1:8b
