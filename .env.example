# `.\tasks.ps1 setup` copies this file to .env with a fresh random token.
# Never commit .env.

# Required by src/continuum/connector/auth.py. Every request to the
# connector API, including requests from localhost, must present this
# token as a bearer token. To set one by hand, generate a long random
# value, for example with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONTINUUM_API_TOKEN=change-me-to-a-long-random-token

# Used when rag.llm_provider is groq (the default): IncidentRAG sends the
# question and the retrieved incident and playbook text to Groq's API to
# write the answer. Create a key at https://console.groq.com/keys and paste
# it here. Leave it empty if you set rag.llm_provider to ollama instead.
GROQ_API_KEY=

# Optional overrides of config/default.yaml, shaped
# CONTINUUM_<SECTION>__<FIELD>. Leave commented out to use the defaults.
# CONTINUUM_DETECTION__SENSITIVITY=5
# CONTINUUM_RESPONSE__MODE=lock_and_disable
# CONTINUUM_CONNECTOR__PORT=8731
# CONTINUUM_RAG__OLLAMA_HOST=http://127.0.0.1:11434
# CONTINUUM_RAG__OLLAMA_MODEL=llama3.1:8b
